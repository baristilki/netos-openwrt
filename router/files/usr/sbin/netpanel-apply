#!/bin/sh
# /etc/config/netpanel içeriğinden "inet netpanel" nft tablosunu yeniden kurar:
#   - cihaz başına indirme/yükleme hız sınırı (policing)
#   - cihaz başına internet engeli
#   - cihaz başına trafik sayaçları (dl/ul setleri; canlı hız için)
# fw4 tablosuna dokunmaz; ayrı tablo, forward hook, priority -5.

. "${NP_COMMON:-/usr/share/netpanel/common.sh}"

LAN=$(np_ifdev lan)
[ -n "$LAN" ] || LAN=br-lan
OUT=/tmp/netpanel.nft

# Mbit/s -> kbytes/s ve burst (en az 64 KB, rate'in ~%20'si)
kb() { echo $(($1 * 125)); }
burst() { local b=$(($1 * 25)); [ "$b" -lt 64 ] && b=64; echo "$b"; }

gen() { # $1 = 1 ise sayaçlı
	echo "table inet netpanel"
	echo "delete table inet netpanel"
	echo "table inet netpanel {"
	if [ "$1" = 1 ]; then
		echo "	set dl { type ipv4_addr; size 4096; flags dynamic; }"
		echo "	set ul { type ipv4_addr; size 4096; flags dynamic; }"
	fi
	# Saat planı (ebeveyn kontrolü): collect.sh her dakika bu setleri günceller
	echo "	set schedmac { type ether_addr; size 512; }"
	echo "	set schedip { type ipv4_addr; size 512; }"
	echo "	chain forward {"
	echo "		type filter hook forward priority -5; policy accept;"
	echo "		ether saddr @schedmac drop"
	echo "		ip daddr @schedip drop"
	np_meta | cut -f1,3,4,5,7 | while read -r mac down up blk prio; do
		np_valid_mac "$mac" || continue
		ip=$(np_ip_for_mac "$mac")
		np_valid_ip "$ip" || ip=""
		if [ "$blk" = 1 ]; then
			echo "		ether saddr $mac drop"
			[ -n "$ip" ] && echo "		ip daddr $ip drop"
			continue
		fi
		# Oyun önceliği: cihazın giden trafiğini EF (cake diffserv4 "Voice" kademesi) olarak işaretle.
		# Yalnız SQM betiği layer_cake.qos (diffserv) iken etkilidir; flow offloading kapalı olmalı.
		if [ "${prio:-0}" = 1 ]; then
			echo "		ether saddr $mac ip dscp set ef"
			echo "		ether saddr $mac ip6 dscp set ef"
		fi
		[ "${up:-0}" -gt 0 ] &&
			echo "		ether saddr $mac limit rate over $(kb "$up") kbytes/second burst $(burst "$up") kbytes drop"
		[ "${down:-0}" -gt 0 ] && [ -n "$ip" ] &&
			echo "		ip daddr $ip limit rate over $(kb "$down") kbytes/second burst $(burst "$down") kbytes drop"
	done
	if [ "$1" = 1 ]; then
		echo "		iifname != \"$LAN\" oifname \"$LAN\" update @dl { ip daddr counter }"
		echo "		iifname \"$LAN\" oifname != \"$LAN\" update @ul { ip saddr counter }"
	fi
	echo "	}"
	echo "}"
}

if [ "$(uci -q get netpanel.main.enabled)" = 0 ]; then
	nft delete table inet netpanel 2>/dev/null
	exit 0
fi

if gen 1 >"$OUT" && nft -f "$OUT" 2>/tmp/netpanel.err; then
	echo 1 >/tmp/netpanel.counters
elif gen 0 >"$OUT" && nft -f "$OUT" 2>>/tmp/netpanel.err; then
	echo 0 >/tmp/netpanel.counters
	logger -t netpanel "sayaçlar desteklenmiyor, yalnız sınırlar uygulandı"
else
	logger -t netpanel "nft kuralları yüklenemedi: $(head -c 300 /tmp/netpanel.err)"
	exit 1
fi
# tablo yeniden kuruldu: saat planı setlerini hemen doldur
# (kullanım sayaçları da sıfırlandı; collect.sh bunu "yeni değer < önceki" olarak algılayıp doğru sayar)
/usr/libexec/netpanel/collect.sh sched force >/dev/null 2>&1
